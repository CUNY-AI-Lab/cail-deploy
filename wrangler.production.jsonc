{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // This fleet uses the standalone CAIL Doorway issuer. The deployment label
  // describes this control-plane Worker, not an artifact publication target.
  "name": "kale-release-control-plane",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "AUTH_MODE": "cail-jwt",
    "CAIL_ENVIRONMENT": "production",
    "SERVICE_AUDIENCE": "cail:deploy",
    "PUBLIC_BASE_URL": "https://kale-release-control-plane.ailab-452.workers.dev",
    "CAIL_IDENTITY_ISSUER": "https://cail-doorway.ailab-452.workers.dev/cail-sso",
    "WFP_ACCOUNT_ID": "452c33847cf5cb1e46f391fca32fd1b5",
    "WFP_NAMESPACE": "kale-release-control-plane"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kale-release-control-plane-current",
      "database_id": "13da045d-e006-44db-a0b3-2fc60e6b952e",
      "migrations_dir": "schema"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "kale-release-control-plane" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "6bd78902a86d4736812a077a7351dad1" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "kale-release-control-plane" }],
  "workflows": [
    {
      "name": "kale-release-control-plane",
      "binding": "RELEASE_WORKFLOW",
      "class_name": "ReleaseWorkflow"
    }
  ]
  // CAIL_IDENTITY_JWKS is a deployment secret (standalone Doorway public JWKS).
  // CLOUDFLARE_API_TOKEN (the isolated WfP publisher token) is a deployment
  // secret provisioned separately; publication is unavailable until it is set.
}
