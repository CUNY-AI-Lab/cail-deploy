{
  "name": "@cuny-ai-lab/kale-release-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:workerd && bun run test:harness && bun run test:oauth",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint .",
    "test": "bun test test/*.test.ts",
    "test:harness": "node --test test/harness/*.node.mjs",
    "test:oauth": "bun scripts/check-oauth-config.ts && bun scripts/check-oauth.ts",
    "test:workerd": "bun scripts/check-workerd.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/worker-bundler": "0.2.2",
    "@cloudflare/workers-oauth-provider": "0.5.0",
    "@cuny-ai-lab/cail-identity": "5.2.2",
    "@cuny-ai-lab/cail-log": "0.6.1",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "5.20260801.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oxlint/plugins": "1.79.0",
    "typescript": "5.9.3",
    "oxlint": "1.79.0",
    "wrangler": "4.120.0"
  }
}
