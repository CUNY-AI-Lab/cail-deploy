{
  "name": "@cuny-ai-lab/kale-release-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "bun run check:fixture && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:workerd",
    "check:fixture": "bun scripts/check-fixture.ts",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test test/*.test.ts",
    "test:workerd": "bun scripts/check-workerd.ts",
    "test:workerd:pool-known-drift": "vitest run --config vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/worker-bundler": "0.2.2",
    "@cuny-ai-lab/cail-identity": "file:vendor/cuny-ai-lab-cail-identity-4.6.0.tgz",
    "@cuny-ai-lab/cail-log": "file:vendor/cuny-ai-lab-cail-log-0.6.0.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "5.20260722.1",
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.113.0"
  }
}
