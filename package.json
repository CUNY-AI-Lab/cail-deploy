{
  "name": "@cuny-ai-lab/cail-deploy",
  "private": true,
  "version": "0.1.0",
  "description": "CAIL Deploy control plane, gateway workers, and assistant adapters.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "check": "bun run check:bundle-version && bun run --workspaces --if-present check",
    "check:bundle-version": "node scripts/check-kale-bundle-version.mjs",
    "harness:onboarding": "node --import tsx packages/deploy-service/src/harness-onboarding-run.ts",
    "test": "bun run --workspaces --if-present test",
    "ops:healthcheck": "bash scripts/ops/check-kale-health.sh",
    "ops:lifecycle-smoke": "node scripts/ops/run-kale-lifecycle-smoke.mjs",
    "ops:runner-cache-prune": "bash scripts/ops/prune-runner-cache.sh"
  }
}
