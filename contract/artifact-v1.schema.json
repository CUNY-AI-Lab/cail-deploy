{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuny-ai-lab.invalid/kale/artifact-v1.schema.json",
  "title": "Kale immutable Worker artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "entrypoint",
    "files",
    "compatibility",
    "requestedBindings"
  ],
  "properties": {
    "schemaVersion": { "const": "kale.artifact.v1" },
    "runtime": { "const": "worker" },
    "entrypoint": { "$ref": "#/$defs/safePath" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/safePath" },
      "additionalProperties": { "type": "string" }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "flags"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "flags": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "requestedBindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["d1", "r2", "kv", "secret", "service"] }
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
